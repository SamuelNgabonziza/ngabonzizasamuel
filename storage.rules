rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /post-media/{fileName} {
      function isAdmin() {
        return request.auth != null
          && request.auth.uid == 'H4BHAMvfImcwDgWJF9FaXt6bPdC2';
      }

      // Uploaded post images are displayed publicly on the portfolio.
      allow read: if true;

      // Only the designated site admin may upload images, up to 12 MiB each.
      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size <= 12582912
        && request.resource.contentType.matches('image/.*');
    }
  }
}
